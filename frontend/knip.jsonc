{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // `tests/**` は frontend/tests（ユニット）、`../tests/e2e/**` はリポ直下の
  // Playwright spec（判例4 の置き場）。config は frontend/ に残るので、knip からは
  // 相対で上を見る。
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "../tests/e2e/**/*.ts"],
  // eslint.e2e.config.js は eslint.config.js とリポ直下 eslint.config.js の
  // 両方から読まれる実設定（knip は既定で eslint.config.js しか config として
  // 認識しないので明示する）。
  "entry": ["../tests/e2e/**/*.spec.ts", "eslint.e2e.config.js"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // schema.gen.ts は openapi-typescript の codegen 生成物（正本は docs/openapi）。
    // paths/webhooks/$defs 等の定型 export/type が未使用に見えるのは生成物の性質であり
    // 実コードの負債ではない。完全クローズ open-q1 の hub 裁定（2026-07-21）＝生成物公認差異で
    // C1「台帳0」の対象外（撤去条件なし・恒久）。
    "src/shared/api/schema.gen.ts": ["exports", "types"],
  },
  "tags": ["-knipignore"],
}
